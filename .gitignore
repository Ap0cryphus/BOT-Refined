# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyd
.Python

# Runtime lock files created by kaekae_core.FileLock
*.lock

# Test / harness artifacts
lock_probe.json
_prefeval_backup/
_presync_backup/
runs/
voice_test.wav
temp_say_broadcast.wav
test.wav
